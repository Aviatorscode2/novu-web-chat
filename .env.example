# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Public application identifier from https://dashboard.novu.co/api-keys
# Safe to expose to the browser.
NEXT_PUBLIC_NOVU_APPLICATION_IDENTIFIER=

# Public identifier of the agent that has Web Chat enabled (from the agent's
# dashboard page in Novu). Safe to expose to the browser.
NEXT_PUBLIC_NOVU_AGENT_IDENTIFIER=

# Environment API secret from https://dashboard.novu.co/api-keys.
# Server-only — never prefix this with NEXT_PUBLIC_. Used to compute the
# subscriberHash and agentHash HMACs (see README > Security).
# Optional while prototyping locally with HMAC turned off in Novu, but
# required before this app is shared with anyone else.
NOVU_SECRET_KEY=

# Set to "eu" if your Novu environment is in the EU region. Defaults to "us".
NEXT_PUBLIC_NOVU_REGION=us

# Advanced: only set these to override the region defaults above (e.g. a
# self-hosted Novu instance). Leave blank otherwise.
NEXT_PUBLIC_NOVU_API_URL=
NEXT_PUBLIC_NOVU_SOCKET_URL=
